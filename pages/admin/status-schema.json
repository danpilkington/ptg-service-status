{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PTG published status",
  "type": "object",
  "required": [
    "publishedAt",
    "services",
    "incidents",
    "maintenance"
  ],
  "properties": {
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "enum": [
              "operational",
              "degraded",
              "advisory",
              "outage",
              "maintenance",
              "unknown"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "group": {
            "type": "string",
            "maxLength": 60
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999
          },
          "monitor": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "type",
              "target",
              "interval",
              "paused"
            ],
            "properties": {
              "type": {
                "enum": [
                  "ping",
                  "tcp",
                  "http"
                ]
              },
              "target": {
                "type": "string",
                "maxLength": 2048
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "interval": {
                "enum": [
                  30,
                  60,
                  300
                ]
              },
              "paused": {
                "type": "boolean"
              },
              "expectedText": {
                "type": "string",
                "maxLength": 500
              },
              "secret": {
                "type": "string",
                "description": "Windows DPAPI-encrypted API credentials; server-owned"
              }
            }
          }
        }
      },
      "maxItems": 100
    },
    "incidents": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/notice"
      }
    },
    "maintenance": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/notice"
          },
          {
            "required": [
              "end"
            ]
          }
        ]
      }
    },
    "supportUrls": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    },
    "microsoftAssessments": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "impact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "impact": {
            "enum": [
              "unknown",
              "confirmed",
              "not-affected"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 5000
          },
          "workaround": {
            "type": "string",
            "maxLength": 3000
          },
          "nextUpdateAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "const": ""
              }
            ]
          },
          "updates": {
            "type": "array"
          }
        }
      }
    },
    "retiredServices": {
      "type": "array",
      "description": "Server-maintained service identities retained after removal; these IDs cannot be reused.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "removedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "removedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "announcement": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "title",
        "message",
        "level"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "level": {
          "enum": [
            "info",
            "warning",
            "urgent"
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "notice": {
      "type": "object",
      "required": [
        "id",
        "serviceId",
        "title",
        "message",
        "start"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "serviceId": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "phase": {
          "enum": [
            "investigating",
            "identified",
            "monitoring",
            "resolved"
          ]
        },
        "impact": {
          "enum": [
            "unknown",
            "confirmed",
            "not-affected"
          ]
        },
        "workaround": {
          "type": "string",
          "maxLength": 3000
        },
        "nextUpdateAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "const": ""
            }
          ]
        },
        "resolvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "at",
              "message"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "message": {
                "type": "string"
              },
              "phase": {
                "type": "string"
              },
              "impact": {
                "type": "string"
              }
            }
          }
        },
        "autoStatus": {
          "type": "boolean"
        }
      }
    }
  }
}
