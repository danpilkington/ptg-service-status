HOST=127.0.0.1
PORT=3000
ADMIN_API_KEY=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SUPABASE_ACCESS_TOKEN=

# Optional automatic Freshservice tickets. Leave all three blank to disable.
FRESHSERVICE_DOMAIN=
FRESHSERVICE_API_KEY=
FRESHSERVICE_REQUESTER_EMAIL=
# 1=Low, 2=Medium, 3=High, 4=Urgent
FRESHSERVICE_PRIORITY=3
# Numeric ID of the status used after recovery (11 is Awaiting Verification in this account).
FRESHSERVICE_RECOVERY_STATUS=11
FRESHSERVICE_GROUP_ID=
FRESHSERVICE_WORKSPACE_ID=
# Optional; defaults to freshservice-state.json beside the application.
FRESHSERVICE_STATE_FILE=

# Keep file storage until the SQL migration has completed.
STORAGE_DRIVER=file
# Named-pipe endpoint for the IT1\PROGRESSIVE instance (Windows authentication).
SQL_SERVER=
SQL_DATABASE=
SQL_ODBC_DRIVER=
SQL_TRUST_SERVER_CERTIFICATE=
